# ============================================================
# Environment Configuration — Copy to .env and fill in values
# ============================================================

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=faers
POSTGRES_USER=faers_user
POSTGRES_PASSWORD=faers_secret_pw

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_TTL_SECONDS=3600

# --- LLM (choose one) ---
# Option A: OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_MINI_MODEL=gpt-4o-mini

# Option B: Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# Option C: Local Ollama (no key needed)
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=llama3.1:8b

# --- FAERS Data ---
FAERS_DATA_DIR=./data/raw
FAERS_PARQUET_DIR=./data/parquet
DEFAULT_QUARTER=2026q1

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# --- Query Engine ---
QUERY_TIMEOUT_SECONDS=5
ENABLE_CACHE=true
EXPLAIN_RESULTS=true

# --- Caddy / TLS (required when running with docker-compose) ---
# The public domain Caddy will request a Let's Encrypt certificate for.
# Must point to this server's IP in DNS before you start the stack.
APP_DOMAIN=faers.example.com

# Optional: email for Let's Encrypt expiry notices
# ACME_EMAIL=admin@example.com
