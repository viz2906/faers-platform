FROM python:3.11-slim

WORKDIR /app

# Install dependencies first for caching
COPY pyproject.toml .
RUN pip install -e .

# Copy application code
COPY api/ api/
COPY nlp/ nlp/
COPY analytics/ analytics/
COPY database/ database/

# Expose API port
EXPOSE 8000

# Run FastAPI server
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
